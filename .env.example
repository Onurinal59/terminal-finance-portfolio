# --- Mevcut iskelet (Manus şablonu; şu an kullanılmıyor) ---
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=

# --- Yönetim paneli (/admin) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Panele girebilecek e-postalar, virgülle ayrılır. Boşsa kimse giremez.
ADMIN_EMAILS=onurinal815@gmail.com
# Oturum çerezini imzalar. En az 32 karakter rastgele bir dize üretin.
ADMIN_SESSION_SECRET=
# OAuth dönüş adresinin kökü. Üretimde https://onurinal.vercel.app
ADMIN_BASE_URL=https://onurinal.vercel.app

# --- İçerik ve dosya deposu ---
# Vercel > Storage > Blob store oluşturup projeye bağlayınca otomatik gelir.
BLOB_READ_WRITE_TOKEN=

# --- Makro veri sağlayıcıları (isteğe bağlı) ---
# Yahoo Finance, ECB Data Portal ve New York Fed anahtarsız çalışır.
# Aşağıdakiler ücretsizdir ama kayıt ister; tanımlanmazsa o göstergeler
# panelden elle güncellenir.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://evds2.tcmb.gov.tr/ → üye ol → Profil → API Anahtarı
EVDS_API_KEY=
